# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# --- App settings (read by src/ecrime_demo/settings.py) ---
ECRIME_DATABASE_URL=sqlite+aiosqlite:///database/ecrime_demo.db
ECRIME_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# --- Amazon Bedrock model used by POST /v1/chat (placeholders: replace with your own) ---
# Put your real values in backend/.env (git-ignored), never in this file.
# The AWS_* names are the standard ones, read through boto3 (from .env or the real environment).
# /v1/chat needs these: with no model configured, or if the call fails, it returns 503 (no canned answers).
# The only reply that never uses the model is the fixed "call 999" answer for emergencies.
# Replies are streamed (POST /v1/chat/stream), so the first words appear in about a second.
AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
AWS_SESSION_TOKEN=replace-with-your-session-token
AWS_REGION=us-west-2

# Model to call, e.g. an Amazon Bedrock model ID or inference profile ID.
ECRIME_MODEL_ID=replace-with-your-model-id

# --- Speech-to-text: POST /v1/speech/transcribe (faster-whisper, runs on this machine, no AWS needed) ---
# Models download from Hugging Face on first use (base is about 150 MB), then are cached.
# ECRIME_STT_MODEL=base            # tiny | base | small | medium | large-v3. Bigger is more accurate and slower.
# ECRIME_STT_PRELOAD=true          # load the model in the background at startup so the first recording is not slow
# ECRIME_STT_DEVICE=cpu            # cpu | cuda
# ECRIME_STT_COMPUTE_TYPE=int8     # int8 for cpu, float16 for cuda
# ECRIME_STT_MAX_AUDIO_BYTES=10485760
# ECRIME_STT_MAX_AUDIO_SECONDS=60
