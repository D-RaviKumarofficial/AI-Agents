    "/v1/chat": {
      "post": {
        "tags": [
          "v1"
        ],
        "summary": "Ask the services assistant",
        "description": "Answer a question about services with the language model. 503 if it is unavailable. Nothing is stored.",
        "operationId": "chat_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/stream": {
      "post": {
        "tags": [
          "v1"
        ],
        "summary": "Ask the services assistant, streamed word by word",
        "description": "Same as `/chat`, but the answer arrives as Server-Sent Events: `delta` pieces, then `done` (or `error`).\n\nA missing model is reported as a normal 503 before the stream starts. Nothing is stored.",
        "operationId": "chat_stream_v1_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/speech/transcribe": {
      "post": {
        "tags": [
          "speech"
        ],
        "summary": "Turn a recording into text",
        "description": "Recognise the speech in a recording (webm, ogg, mp4/m4a, wav, mp3 or flac) with faster-whisper.\n\nSend the audio file as the request body with its `Content-Type`. Runs on this machine: no AWS, nothing is stored.\nReturns 413 if the file is too large, 415 for a non-audio type, 422 if it is empty, too short, too long or cannot be\nread, and 503 if the speech model is unavailable.",
        "operationId": "transcribe_v1_speech_transcribe_post",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 12
                },
                {
                  "type": "null"
                }
              ],
              "description": "Language code such as en, ar or ta. Leave out to detect it.",
              "title": "Language"
            },
            "description": "Language code such as en, ar or ta. Leave out to detect it."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptionOut"
                }
              }
            }
          },
          "413": {
            "description": "The recording is larger than the limit (10 MB by default). `AUDIO_TOO_LARGE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "The request is not declared as audio. `UNSUPPORTED_AUDIO_TYPE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Empty, unreadable, too short or too long recording (`AUDIO_INVALID`, `AUDIO_TOO_LONG`), or an unknown `language` (`UNSUPPORTED_LANGUAGE`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "The speech model could not be loaded or failed. `SPEECH_UNAVAILABLE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "description": "The audio file itself (the raw bytes), for example a browser recording.",
          "content": {
            "audio/webm": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "audio/ogg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "audio/mp4": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "audio/mpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "audio/wav": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "audio/flac": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessLevel": {
        "type": "string",
        "enum": [
          "uae_pass_required",
          "guest_available",
          "unknown"
        ],
        "title": "AccessLevel",
        "description": "What was observed about signing in to a service's initial form."
      },
      "AnswerSource": {
        "type": "string",
        "enum": [
          "model",
          "safety"
        ],
        "title": "AnswerSource",
        "description": "Where an answer came from: the language model, or the fixed emergency (safety) reply."
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Message"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "type": "array",
            "maxItems": 20,
            "title": "History",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "description": "A user message, with optional earlier turns."
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "services": {
            "items": {
