            },
            "type": "array",
            "title": "Services",
            "default": []
          },
          "source": {
            "$ref": "#/components/schemas/AnswerSource"
          }
        },
        "type": "object",
        "required": [
          "reply",
          "source"
        ],
        "title": "ChatResponse",
        "description": "The assistant's answer and the services it is about."
      },
      "ChatTurn": {
        "properties": {
