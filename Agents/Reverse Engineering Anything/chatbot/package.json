{
  "name": "rea-chat-widget",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable floating chat widget for React. No backend code and no app-specific text: the host app supplies the send function, wording and colours.",
  "type": "module",
  "main": "./dist/chat-widget.js",
  "module": "./dist/chat-widget.js",
  "exports": {
    ".": "./dist/chat-widget.js",
    "./style.css": "./dist/chat-widget.css"
  },
  "files": ["dist", "README.md"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "vite build",
    "demo": "vite --open /demo/",
    "test": "vitest run",
    "prepare": "vite build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
